<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow existing physical files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route /api/ and /places/ through backend index.php
  RewriteCond %{REQUEST_URI} (api|places)/? [NC]
  RewriteRule ^ index.php [L]

  # Route /admin and /admin/* to admin/index.html
  RewriteCond %{REQUEST_URI} admin(/|$) [NC]
  RewriteRule ^ admin/index.html [L]

  # Route all other client URLs to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Performance: Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Performance: Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
