# Red Taxi Frontend Environment Configuration
# If the frontend and backend are hosted on the SAME domain/port (or using reverse proxy):
# Leave VITE_API_BASE_URL empty or unset (defaults to relative /api/v1)
VITE_API_BASE_URL=

# If the backend is hosted on a separate domain, subdomain, or port:
# Examples:
# VITE_API_BASE_URL=https://api.redtaxi.com
# VITE_API_BASE_URL=http://your-server-ip:8000
