# JittaDrives / RedTaxi Backend Environment Configuration
APP_NAME="JittaDrives API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://xiadot.com
API_PREFIX=/api/v1

# MySQL Database Connection (cPanel MySQL Database Credentials)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_dbname
DB_USER=your_cpanel_dbuser
DB_PASS=your_cpanel_dbpassword
DB_CHARSET=utf8mb4

# CORS Settings
CORS_ALLOWED_ORIGINS="https://xiadot.com,http://localhost:5173,http://localhost:5174"
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type, Authorization, X-Requested-With"
CORS_ALLOW_CREDENTIALS=true

# JWT Token Secret
JWT_SECRET=jittadrives_secure_jwt_secret_token_2026
JWT_EXPIRY_HOURS=720
